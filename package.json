{
  "name": "drmk-inventory-sync",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "web:preview": "pnpm --filter web preview",
    "web:deploy": "pnpm --filter web run deploy",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "smoke:rrr": "pnpm --filter @drmk/rrr-client smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @drmk/db generate",
    "db:migrate": "pnpm --filter @drmk/db migrate",
    "db:studio": "pnpm --filter @drmk/db studio",
    "users:add": "node --env-file-if-exists=.env packages/db/scripts/add-user.ts",
    "sync:full": "pnpm --filter worker sync:full",
    "sync:incremental": "pnpm --filter worker sync:incremental",
    "sync:cars": "pnpm --filter worker sync:cars",
    "images:rehost": "pnpm --filter worker images:rehost",
    "scheduler:deploy": "pnpm --filter scheduler run deploy"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}

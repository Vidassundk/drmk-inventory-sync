{
  "name": "deremika",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "smoke:rrr": "pnpm --filter @deremika/rrr-client smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @deremika/db generate",
    "db:migrate": "pnpm --filter @deremika/db migrate",
    "db:studio": "pnpm --filter @deremika/db studio",
    "sync:full": "pnpm --filter worker sync:full",
    "sync:incremental": "pnpm --filter worker sync:incremental",
    "images:rehost": "pnpm --filter worker images:rehost"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}

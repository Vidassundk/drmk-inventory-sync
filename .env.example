# Copy to .env and fill in. Credentials come from your RRR account.
# Production: https://api.rrr.lt/   Staging: https://staging-api.rrr.lt/
RRR_BASE_URL=https://api.rrr.lt/
RRR_USERNAME=
RRR_PASSWORD=
RRR_USER_TOKEN=

# Supabase → Connect → Session pooler (port 5432). Not the direct (IPv6-only) URL.
DATABASE_URL=

# Cloudflare R2 (image rehosting). Token: R2 → Manage API tokens → Object Read & Write, this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL images are served from (custom domain, or the bucket's r2.dev URL while testing).
R2_PUBLIC_BASE_URL=

# Dashboard sign-in, for `pnpm dev:web` only. The deployed Worker has its own: `wrangler secret put` in apps/web.
# Any long random string, such as the output of `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# Optional locally. Without it, sign-in codes are printed in the dev server's terminal instead of emailed.
RESEND_API_KEY=

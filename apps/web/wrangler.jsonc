{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drmk-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Turn workers_dev off once the site sits behind Cloudflare Access on its own domain.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference used by the adapter; the service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "drmk-web",
    },
  ],
}

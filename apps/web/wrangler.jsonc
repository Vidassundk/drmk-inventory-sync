{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drmk-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare Access only protects app.vidasstirbys.com, so nothing else may serve this Worker.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.vidasstirbys.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": { "R2_PUBLIC_BASE_URL": "https://images.vidasstirbys.com" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "fb652d33052e4ea798eec549154c61c9",
      // Placeholder: the deploy command needs a value but never connects. next.config.ts overrides it for local runs.
      "localConnectionString": "postgres://unused:unused@localhost:5432/unused",
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference used by the adapter; the service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "drmk-web",
    },
  ],
}

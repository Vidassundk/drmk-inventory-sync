{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drmk-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  // UTC. Keep in sync with WORKFLOWS in src/index.ts.
  "triggers": { "crons": ["17 * * * *", "4,19,34,49 * * * *", "41 2 * * *"] },
}
